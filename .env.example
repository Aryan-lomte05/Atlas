# MongoDB Atlas Database Connection
# Full connection string from Atlas: Database > Connect > Drivers
# Atlas runs fine without this: traces simply are not persisted.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_ADDRESS>.mongodb.net/atlas_travel?retryWrites=true&w=majority

# Optional: Groq API key for Llama-3.3-70B inference
# If omitted, Atlas runs the ReAct loop against live Open-Meteo, Wikipedia, and mathjs tools
GROQ_API_KEY=
